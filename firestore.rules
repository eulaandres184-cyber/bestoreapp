rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && request.auth.token.bestoreRole == role
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isSeller() {
      return hasRole('seller');
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin() && (userId != '67V2bdleU2bZaazTtoZUvafJTsL2'
        || (request.auth.uid == userId && request.resource.data.role == 'admin' && request.resource.data.active == true));
      allow delete: if isAdmin() && userId != '67V2bdleU2bZaazTtoZUvafJTsL2';
    }

    match /app_state/{document} {
      allow read: if isAdmin() || isSeller();
      allow create: if isAdmin();
      allow update: if request.resource.data.clientWriteId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['clientWriteId'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['salesRevision'])
        && ((isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dailyDollarRate']))
          || (isSeller() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sales', 'updatedAt', 'clientWriteId'])));
    }
  }
}
