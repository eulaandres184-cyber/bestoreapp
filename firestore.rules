rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSeller() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /app_state/{document} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSeller() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sales', 'updatedAt']));
    }
  }
}
